# Copy to .env and fill in. Never commit .env.

# --- LLM (https://console.groq.com/keys) ---
GROQ_API_KEY=

# --- Database ---
# Local dev uses SQLite automatically if this is blank.
# Production: Supabase -> Project Settings -> Database -> Connection string (URI, "Session pooler")
# e.g. postgresql+psycopg://postgres.xxxx:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Optional model overrides ---
LLM_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=llama-3.1-8b-instant
