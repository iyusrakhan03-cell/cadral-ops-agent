# Copy to .env and fill in. Never commit .env.

# --- LLM (https://console.groq.com/keys) ---
GROQ_API_KEY=

# --- Database ---
# Blank = SQLite (backend/data/local.db) — used locally AND on the free Hugging Face Space, where it is backed up
# to a private HF dataset (see DB_BACKUP_REPO below). Free Spaces can't reach Postgres ports, so no Supabase there.
# On a host that allows it: postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=

# --- Optional model overrides ---
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# --- Vector database (https://app.pinecone.io -> API Keys; free Starter plan) ---
# Blank = search runs from the local index in backend/index/ (also the automatic fallback).
PINECONE_API_KEY=
# After setting it, upload the knowledge base once:  python -m scripts.build_index

# --- Fine-tuned router model (optional) ---
# Downloaded automatically from Hugging Face on first use (~1 GB) into backend/models/.
# ROUTER_MODEL=llm forces the GPT-OSS-20B classifier instead.
ROUTER_GGUF_REPO=iyusrakhan/tp-router-qwen2.5-1.5b-gguf
ROUTER_MODEL=auto

# ====================================================================== Day 3-4: hosting
# Hugging Face token with WRITE access (https://huggingface.co/settings/tokens). Used by deploy/deploy_backend.py
# and, on the Space, for the database backups. A fine-grained token limited to the Space + backup dataset is best.
HF_TOKEN=
DASHBOARD_URL=https://thistle-pine-dashboard.vercel.app
# Generated by deploy/deploy_backend.py if blank: JWT_SECRET, BRIDGE_KEY, DB_BACKUP_REPO, RELAY_URL, CORS_ORIGINS
JWT_SECRET=
BRIDGE_KEY=
ADMIN_PASSWORD=
AGENT_PASSWORD=

# ====================================================================== Day 4: channels & automation
# Slack: api.slack.com/apps -> Create app -> Incoming Webhooks -> Add to a channel -> copy the URL
SLACK_WEBHOOK_URL=
# Who gets the daily management report (sent at REPORT_HOUR shop time through the Gmail bridge)
MANAGER_EMAIL=
REPORT_HOUR=8
REPORT_TIMEZONE=Europe/London
# Telegram: talk to @BotFather -> /newbot -> copy the token. Used by deploy/set_telegram_webhook.py and on Vercel.
TELEGRAM_BOT_TOKEN=
