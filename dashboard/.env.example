# URL of the FastAPI backend (backend/app/main.py)
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Telegram relay (server-side only; set these in Vercel > Settings > Environment Variables) ---
# Same value as BRIDGE_KEY in the backend .env / Space secrets
BRIDGE_KEY=
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Any long random string; deploy/set_telegram_webhook.py registers it with Telegram
TELEGRAM_WEBHOOK_SECRET=
